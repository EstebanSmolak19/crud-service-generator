<?php

namespace {{ namespace }};

use {{ modelNamespace }}\{{ model }};
use EstebanSmolak19\CrudServiceGenerator\Services\CrudServiceBase;
use EstebanSmolak19\CrudServiceGenerator\Contracts\IFillableContract;
use EstebanSmolak19\CrudServiceGenerator\Contracts\HasSqlOverrides;
use EstebanSmolak19\CrudServiceGenerator\Attributes\IsAuthenticated;
use EstebanSmolak19\CrudServiceGenerator\Attributes\IsService;

/**
 * Class {{ class }}
 * * Pour personnaliser la configuration (tri, pagination, audit),
 * @see \EstebanSmolak19\CrudServiceGenerator\Traits\HasCrudConfiguration
 */
 #[IsService]
class {{ class }} extends CrudServiceBase implements IFillableContract, HasSqlOverrides
{
    protected array $fillable = [''];

    /**
     * Le constructeur par défaut
     */
    public function __construct({{ model }} $model)
    {
        // On instancie le modèle et on le passe à la classe parente
        parent::__construct($model);
    }

    /**
     * Gestion des permissions par méthode du service CRUD.
     * Déclarez ici quel attribut doit s'exécuter pour chaque action.
    */
    public function permissions(): array
    {
        return [
            // 'all'     => [], // Tout le monde peut voir
            'create'  => [IsAuthenticated::class], // Connecté requis pour créer
            'update'  => [IsAuthenticated::class], // Connecté requis pour modifier
            'destroy' => [IsAuthenticated::class], // Connecté requis pour supprimer
        ];
    }
}